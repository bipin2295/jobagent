# Copy to .env and fill in your values.
# All values are optional to start - the profile importer works without any keys.

# ── LLM (Portkey) ──────────────────────────────────────────────────
# This is the same key OpenCode uses (CIMPRESS_AI_GATEWAY_KEY).
# It lives in ~/.local/share/opencode/auth.json under "https://opencode.vista.io".
JOBAGENT_PORTKEY_API_KEY=
# Vista / Cimpress AI gateway. Auth flows via x-portkey-api-key header; the
# model field must use the internal id (e.g. @Anthropic/eu.anthropic.claude-sonnet-5-5).
# Change to https://api.portkey.ai/v1 and update model ids if using public Portkey.
JOBAGENT_PORTKEY_BASE_URL=https://gateway.ai.cimpress.io/v1

# ── Ollama (local embeddings, free) ────────────────────────────────
JOBAGENT_OLLAMA_BASE_URL=http://localhost:11434
JOBAGENT_OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Telegram ───────────────────────────────────────────────────────
JOBAGENT_TELEGRAM_BOT_TOKEN=
JOBAGENT_TELEGRAM_CHAT_ID=

# ── Gmail OAuth ────────────────────────────────────────────────────
# Path to the client_secret.json downloaded from Google Cloud Console.
# Run `jobagent gmail connect` after placing the file here.
JOBAGENT_GMAIL_CLIENT_SECRET_PATH=data/secrets/client_secret.json
JOBAGENT_GMAIL_TOKEN_PATH=data/secrets/gmail_token.json

# ── Job-board API keys (free tiers) ────────────────────────────────
JOBAGENT_ADZUNA_APP_ID=
JOBAGENT_ADZUNA_APP_KEY=
JOBAGENT_JOOBLE_API_KEY=
JOBAGENT_REED_API_KEY=

# ── Scraping fallbacks (optional, budget-capped) ───────────────────
JOBAGENT_APIFY_API_TOKEN=
JOBAGENT_FIRECRAWL_API_KEY=

# ── Paths ──────────────────────────────────────────────────────────
JOBAGENT_DATA_DIR=data
JOBAGENT_DB_PATH=data/jobagent.db
JOBAGENT_PROFILE_SOURCE=~/Documents/resume/master_resume.txt
